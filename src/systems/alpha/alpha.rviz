Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Ground Truth Path
      Enabled: true
      Topic: /alpha/localisation/ground_truth/path
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Path
      Name: Kalman Filter Path
      Enabled: true
      Topic: /alpha/localisation/kalman_filter/path
      Color: 255; 0; 0
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: map
      Distance: 12
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Width: 1200
