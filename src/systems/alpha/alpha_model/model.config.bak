<?xml version="1.0" ?>
<model config="model.config">
  <name>alpha_rover</name>
  <version>1.0</version>
  <sdf version="1.6">
    <author>
      <name>richar-j</name>
    </author>
    <description>Alpha rover configuration</description>
  </name>

  <plugin name="alpha_ros_control" filename="libgazebo_ros_control.so">
    <robotNamespace>alpha</robotNamespace>
  </plugin>

  <plugin name="alpha_gazebo_ros_imu" filename="libgazebo_ros_imu.so">
    <robotNamespace>alpha</robotNamespace>
    <topicName>alpha/imu</topicName>
  </plugin>

  <plugin name="alpha_gazebo_ros_joint_state" filename="libgazebo_ros_joint_state.so">
    <robotNamespace>alpha</robotNamespace>
    <jointName>alpha_left_joint</jointName>
    <jointName>alpha_right_joint</jointName>
  </plugin>
</model>