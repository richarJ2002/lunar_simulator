<?xml version="1.0"?>
<!--
  Alpha rover, dimensioned after ESA's Rosalind Franklin / ExoMars rover.

  Coordinate convention: +X forward, +Y left, +Z up. Dimensions are metres.
  The mobility geometry follows the published ExoMars BEMA values:
    - left and right longitudinal front bogies plus one transverse rear bogie
    - six independently walking, steering and driven wheels (6x6x6+6)
    - flight-BEMA wheel diameter 0.285 m, width 0.120 m
    - full-scale testbed track 1.200 m, front-centre spacing 0.640 m,
      and centre-rear spacing 0.720 m (1.360 m wheelbase)
  Beam profiles and actuator housings are scaled from published BEMA figures;
  their detailed flight-production dimensions have not been published.
  Both engineering camera benches use the published 0.150 m stereo baseline.
-->
<sdf version="1.10">
  <model name="alpha_rover">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="alpha/base_link">
      <pose>0 0 0.72 0 0 0</pose>
      <inertial>
        <pose>0.04 0 0 0 0 0</pose>
        <mass>202</mass>
        <inertia>
          <ixx>22.77</ixx><iyy>30.51</iyy><izz>44.86</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0.04 0 0 0 0 0</pose>
        <geometry><box><size>1.25 1.05 0.50</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0.04 0 0 0 0 0</pose>
        <geometry><box><size>1.25 1.05 0.50</size></box></geometry>
        <material><ambient>0.64 0.58 0.44 1</ambient><diffuse>0.78 0.70 0.52 1</diffuse><specular>0.15 0.15 0.12 1</specular></material>
      </visual>
      <visual name="front_bevel_visual">
        <pose>0.67 0 -0.05 0 0.20 0</pose>
        <geometry><box><size>0.18 0.99 0.38</size></box></geometry>
        <material><ambient>0.52 0.48 0.38 1</ambient><diffuse>0.70 0.64 0.48 1</diffuse></material>
      </visual>
      <sensor name="alpha_imu" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate><topic>/alpha/raw/imu</topic>
        <!-- Noise is applied by alpha_driver_node from Alpha ROS parameters. -->
        <imu/>
      </sensor>
    </link>

    <!-- Solar array: the deployed width sets the rover's published 2.5 m envelope. -->
    <link name="alpha/solar_array_link">
      <pose>0 0 1.01 0 0 0</pose>
      <inertial><mass>25</mass><inertia><ixx>13.08</ixx><iyy>2.14</iyy><izz>15.20</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="solar_collision"><geometry><box><size>1.75 2.50 0.055</size></box></geometry></collision>
      <visual name="solar_visual">
        <geometry><box><size>1.75 2.50 0.055</size></box></geometry>
        <material><ambient>0.02 0.08 0.18 1</ambient><diffuse>0.03 0.16 0.38 1</diffuse><specular>0.35 0.35 0.40 1</specular></material>
      </visual>
      <visual name="solar_centre_divider"><pose>0 0 0.032 0 0 0</pose><geometry><box><size>1.78 0.025 0.018</size></box></geometry><material><ambient>0.70 0.70 0.70 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material></visual>
      <visual name="solar_cross_divider"><pose>0 0 0.032 0 0 0</pose><geometry><box><size>0.025 2.48 0.018</size></box></geometry><material><ambient>0.70 0.70 0.70 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material></visual>
    </link>
    <joint name="alpha/solar_array_joint" type="fixed"><parent>alpha/base_link</parent><child>alpha/solar_array_link</child></joint>

    <!--
      ExoMars triple-bogie topology: the front and centre wheels form a
      longitudinal bogie on each side; the left and right rear wheels form
      the third, transverse bogie.
    -->
    <link name="alpha/front_left_bogie_link">
      <pose>0.32 0.60 0.54 0 0 0</pose>
      <inertial><mass>6</mass><inertia><ixx>0.02</ixx><iyy>0.27</iyy><izz>0.27</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="shaped_beam">
        <pose>0 0.045 0 1.5707963 0 0</pose>
        <geometry><polyline><height>0.09</height><point>-0.36 0</point><point>-0.29 0.11</point><point>-0.08 0.13</point><point>0 0.075</point><point>0.08 0.13</point><point>0.29 0.11</point><point>0.36 0</point><point>0.28 0.025</point><point>0.08 0.06</point><point>0 0.025</point><point>-0.08 0.06</point><point>-0.28 0.025</point></polyline></geometry>
        <material><ambient>0.42 0.40 0.34 1</ambient><diffuse>0.68 0.65 0.54 1</diffuse><specular>0.25 0.25 0.22 1</specular></material>
      </visual>
      <visual name="pivot_housing"><pose>0 0 0.09 1.5707963 0 0</pose><geometry><cylinder><radius>0.105</radius><length>0.13</length></cylinder></geometry><material><ambient>0.32 0.31 0.27 1</ambient><diffuse>0.55 0.53 0.45 1</diffuse></material></visual>
      <visual name="front_dep_actuator"><pose>0.32 0 0 1.5707963 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.1262</length></cylinder></geometry><material><ambient>0.18 0.19 0.18 1</ambient><diffuse>0.34 0.36 0.34 1</diffuse></material></visual>
      <visual name="centre_dep_actuator"><pose>-0.32 0 0 1.5707963 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.1262</length></cylinder></geometry><material><ambient>0.18 0.19 0.18 1</ambient><diffuse>0.34 0.36 0.34 1</diffuse></material></visual>
    </link>
    <link name="alpha/front_right_bogie_link">
      <pose>0.32 -0.60 0.54 0 0 0</pose>
      <inertial><mass>6</mass><inertia><ixx>0.02</ixx><iyy>0.27</iyy><izz>0.27</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="shaped_beam">
        <pose>0 0.045 0 1.5707963 0 0</pose>
        <geometry><polyline><height>0.09</height><point>-0.36 0</point><point>-0.29 0.11</point><point>-0.08 0.13</point><point>0 0.075</point><point>0.08 0.13</point><point>0.29 0.11</point><point>0.36 0</point><point>0.28 0.025</point><point>0.08 0.06</point><point>0 0.025</point><point>-0.08 0.06</point><point>-0.28 0.025</point></polyline></geometry>
        <material><ambient>0.42 0.40 0.34 1</ambient><diffuse>0.68 0.65 0.54 1</diffuse><specular>0.25 0.25 0.22 1</specular></material>
      </visual>
      <visual name="pivot_housing"><pose>0 0 0.09 1.5707963 0 0</pose><geometry><cylinder><radius>0.105</radius><length>0.13</length></cylinder></geometry><material><ambient>0.32 0.31 0.27 1</ambient><diffuse>0.55 0.53 0.45 1</diffuse></material></visual>
      <visual name="front_dep_actuator"><pose>0.32 0 0 1.5707963 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.1262</length></cylinder></geometry><material><ambient>0.18 0.19 0.18 1</ambient><diffuse>0.34 0.36 0.34 1</diffuse></material></visual>
      <visual name="centre_dep_actuator"><pose>-0.32 0 0 1.5707963 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.1262</length></cylinder></geometry><material><ambient>0.18 0.19 0.18 1</ambient><diffuse>0.34 0.36 0.34 1</diffuse></material></visual>
    </link>
    <link name="alpha/rear_bogie_link">
      <pose>-0.72 0 0.54 0 0 0</pose>
      <inertial><mass>6</mass><inertia><ixx>0.86</ixx><iyy>0.02</iyy><izz>0.86</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="shaped_beam">
        <pose>-0.045 0 0 1.5707963 0 1.5707963</pose>
        <geometry><polyline><height>0.09</height><point>-0.64 0</point><point>-0.54 0.11</point><point>-0.12 0.13</point><point>0 0.075</point><point>0.12 0.13</point><point>0.54 0.11</point><point>0.64 0</point><point>0.54 0.025</point><point>0.12 0.06</point><point>0 0.025</point><point>-0.12 0.06</point><point>-0.54 0.025</point></polyline></geometry>
        <material><ambient>0.42 0.40 0.34 1</ambient><diffuse>0.68 0.65 0.54 1</diffuse><specular>0.25 0.25 0.22 1</specular></material>
      </visual>
      <visual name="pivot_housing"><pose>0 0 0.09 0 1.5707963 0</pose><geometry><cylinder><radius>0.105</radius><length>0.13</length></cylinder></geometry><material><ambient>0.32 0.31 0.27 1</ambient><diffuse>0.55 0.53 0.45 1</diffuse></material></visual>
      <visual name="left_dep_actuator"><pose>0 0.60 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.1262</length></cylinder></geometry><material><ambient>0.18 0.19 0.18 1</ambient><diffuse>0.34 0.36 0.34 1</diffuse></material></visual>
      <visual name="right_dep_actuator"><pose>0 -0.60 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.1262</length></cylinder></geometry><material><ambient>0.18 0.19 0.18 1</ambient><diffuse>0.34 0.36 0.34 1</diffuse></material></visual>
    </link>
    <joint name="alpha/front_left_bogie_joint" type="revolute">
      <pose relative_to="alpha/base_link">0.32 0.60 -0.18 0 0 0</pose><parent>alpha/base_link</parent><child>alpha/front_left_bogie_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.35</lower><upper>0.35</upper><effort>1000</effort><velocity>0.5</velocity></limit><dynamics><damping>30</damping><friction>10</friction></dynamics></axis>
    </joint>
    <joint name="alpha/front_right_bogie_joint" type="revolute">
      <pose relative_to="alpha/base_link">0.32 -0.60 -0.18 0 0 0</pose><parent>alpha/base_link</parent><child>alpha/front_right_bogie_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.35</lower><upper>0.35</upper><effort>1000</effort><velocity>0.5</velocity></limit><dynamics><damping>30</damping><friction>10</friction></dynamics></axis>
    </joint>
    <joint name="alpha/rear_bogie_joint" type="revolute">
      <pose relative_to="alpha/base_link">-0.72 0 -0.18 0 0 0</pose><parent>alpha/base_link</parent><child>alpha/rear_bogie_link</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.35</lower><upper>0.35</upper><effort>1000</effort><velocity>0.5</velocity></limit><dynamics><damping>30</damping><friction>10</friction></dynamics></axis>
    </joint>

    <!-- Wheel-walking legs: one independently actuated vertical leg per wheel. -->
    <link name="alpha/front_left_walk_link"><pose>0.64 0.60 0.34125 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="leg"><geometry><box><size>0.10 0.075 0.3975</size></box></geometry><material><ambient>0.32 0.31 0.28 1</ambient><diffuse>0.50 0.49 0.44 1</diffuse></material></visual></link>
    <link name="alpha/front_right_walk_link"><pose>0.64 -0.60 0.34125 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="leg"><geometry><box><size>0.10 0.075 0.3975</size></box></geometry><material><ambient>0.32 0.31 0.28 1</ambient><diffuse>0.50 0.49 0.44 1</diffuse></material></visual></link>
    <link name="alpha/centre_left_walk_link"><pose>0 0.60 0.34125 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="leg"><geometry><box><size>0.10 0.075 0.3975</size></box></geometry><material><ambient>0.32 0.31 0.28 1</ambient><diffuse>0.50 0.49 0.44 1</diffuse></material></visual></link>
    <link name="alpha/centre_right_walk_link"><pose>0 -0.60 0.34125 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="leg"><geometry><box><size>0.10 0.075 0.3975</size></box></geometry><material><ambient>0.32 0.31 0.28 1</ambient><diffuse>0.50 0.49 0.44 1</diffuse></material></visual></link>
    <link name="alpha/rear_left_walk_link"><pose>-0.72 0.60 0.34125 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="leg"><geometry><box><size>0.10 0.075 0.3975</size></box></geometry><material><ambient>0.32 0.31 0.28 1</ambient><diffuse>0.50 0.49 0.44 1</diffuse></material></visual></link>
    <link name="alpha/rear_right_walk_link"><pose>-0.72 -0.60 0.34125 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="leg"><geometry><box><size>0.10 0.075 0.3975</size></box></geometry><material><ambient>0.32 0.31 0.28 1</ambient><diffuse>0.50 0.49 0.44 1</diffuse></material></visual></link>

    <!--
      Fixed, not revolute: this simulator has no wheel-walking locomotion
      mode (ESA's real DEP actuators exist to give ExoMars that gait, which
      Alpha does not use), so these joints carry no live degree of freedom
      to control; a rigid weld is both simpler and inherently stable,
      unlike a controller trying to hold a moving target (see
      DIMENSIONS.md's "Wheel-walking (DEP) actuators" section for the
      rejected active-control attempt this replaces). The bogie pivot
      above stays genuinely passive/revolute; each wheel-leg assembly now
      just moves rigidly with its own bogie beam as one body.
    -->
    <joint name="alpha/front_left_walk_joint" type="fixed"><pose relative_to="alpha/front_left_bogie_link">0.32 0 0 0 0 0</pose><parent>alpha/front_left_bogie_link</parent><child>alpha/front_left_walk_link</child></joint>
    <joint name="alpha/centre_left_walk_joint" type="fixed"><pose relative_to="alpha/front_left_bogie_link">-0.32 0 0 0 0 0</pose><parent>alpha/front_left_bogie_link</parent><child>alpha/centre_left_walk_link</child></joint>
    <joint name="alpha/front_right_walk_joint" type="fixed"><pose relative_to="alpha/front_right_bogie_link">0.32 0 0 0 0 0</pose><parent>alpha/front_right_bogie_link</parent><child>alpha/front_right_walk_link</child></joint>
    <joint name="alpha/centre_right_walk_joint" type="fixed"><pose relative_to="alpha/front_right_bogie_link">-0.32 0 0 0 0 0</pose><parent>alpha/front_right_bogie_link</parent><child>alpha/centre_right_walk_link</child></joint>
    <joint name="alpha/rear_left_walk_joint" type="fixed"><pose relative_to="alpha/rear_bogie_link">0 0.60 0 0 0 0</pose><parent>alpha/rear_bogie_link</parent><child>alpha/rear_left_walk_link</child></joint>
    <joint name="alpha/rear_right_walk_joint" type="fixed"><pose relative_to="alpha/rear_bogie_link">0 -0.60 0 0 0 0</pose><parent>alpha/rear_bogie_link</parent><child>alpha/rear_right_walk_link</child></joint>

    <!-- Vertical steering knuckles. -->
    <link name="alpha/front_left_steer_link"><pose>0.64 0.60 0.1425 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hub"><geometry><cylinder><radius>0.065</radius><length>0.12</length></cylinder></geometry><material><ambient>0.22 0.22 0.20 1</ambient><diffuse>0.40 0.40 0.36 1</diffuse></material></visual></link>
    <link name="alpha/front_right_steer_link"><pose>0.64 -0.60 0.1425 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hub"><geometry><cylinder><radius>0.065</radius><length>0.12</length></cylinder></geometry><material><ambient>0.22 0.22 0.20 1</ambient><diffuse>0.40 0.40 0.36 1</diffuse></material></visual></link>
    <link name="alpha/centre_left_steer_link"><pose>0 0.60 0.1425 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hub"><geometry><cylinder><radius>0.065</radius><length>0.12</length></cylinder></geometry><material><ambient>0.22 0.22 0.20 1</ambient><diffuse>0.40 0.40 0.36 1</diffuse></material></visual></link>
    <link name="alpha/centre_right_steer_link"><pose>0 -0.60 0.1425 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hub"><geometry><cylinder><radius>0.065</radius><length>0.12</length></cylinder></geometry><material><ambient>0.22 0.22 0.20 1</ambient><diffuse>0.40 0.40 0.36 1</diffuse></material></visual></link>
    <link name="alpha/rear_left_steer_link"><pose>-0.72 0.60 0.1425 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hub"><geometry><cylinder><radius>0.065</radius><length>0.12</length></cylinder></geometry><material><ambient>0.22 0.22 0.20 1</ambient><diffuse>0.40 0.40 0.36 1</diffuse></material></visual></link>
    <link name="alpha/rear_right_steer_link"><pose>-0.72 -0.60 0.1425 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hub"><geometry><cylinder><radius>0.065</radius><length>0.12</length></cylinder></geometry><material><ambient>0.22 0.22 0.20 1</ambient><diffuse>0.40 0.40 0.36 1</diffuse></material></visual></link>

    <joint name="alpha/front_left_steer_joint" type="revolute"><parent>alpha/front_left_walk_link</parent><child>alpha/front_left_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper><effort>500</effort><velocity>0.7</velocity></limit><dynamics><damping>4</damping></dynamics></axis></joint>
    <joint name="alpha/front_right_steer_joint" type="revolute"><parent>alpha/front_right_walk_link</parent><child>alpha/front_right_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper><effort>500</effort><velocity>0.7</velocity></limit><dynamics><damping>4</damping></dynamics></axis></joint>
    <joint name="alpha/centre_left_steer_joint" type="revolute"><parent>alpha/centre_left_walk_link</parent><child>alpha/centre_left_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper><effort>500</effort><velocity>0.7</velocity></limit><dynamics><damping>4</damping></dynamics></axis></joint>
    <joint name="alpha/centre_right_steer_joint" type="revolute"><parent>alpha/centre_right_walk_link</parent><child>alpha/centre_right_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper><effort>500</effort><velocity>0.7</velocity></limit><dynamics><damping>4</damping></dynamics></axis></joint>
    <joint name="alpha/rear_left_steer_joint" type="revolute"><parent>alpha/rear_left_walk_link</parent><child>alpha/rear_left_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper><effort>500</effort><velocity>0.7</velocity></limit><dynamics><damping>4</damping></dynamics></axis></joint>
    <joint name="alpha/rear_right_steer_joint" type="revolute"><parent>alpha/rear_right_walk_link</parent><child>alpha/rear_right_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper><effort>500</effort><velocity>0.7</velocity></limit><dynamics><damping>4</damping></dynamics></axis></joint>

    <!-- 285 x 120 mm flexible-wheel envelopes with a metallic finish. -->
    <link name="alpha/front_left_wheel_link"><pose>0.64 0.60 0.1425 1.5707963 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.041</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="wheel_collision"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><material><ambient>0.20 0.19 0.17 1</ambient><diffuse>0.34 0.32 0.28 1</diffuse><specular>0.25 0.25 0.22 1</specular></material></visual></link>
    <link name="alpha/front_right_wheel_link"><pose>0.64 -0.60 0.1425 1.5707963 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.041</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="wheel_collision"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><material><ambient>0.20 0.19 0.17 1</ambient><diffuse>0.34 0.32 0.28 1</diffuse><specular>0.25 0.25 0.22 1</specular></material></visual></link>
    <link name="alpha/centre_left_wheel_link"><pose>0 0.60 0.1425 1.5707963 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.041</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="wheel_collision"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><material><ambient>0.20 0.19 0.17 1</ambient><diffuse>0.34 0.32 0.28 1</diffuse><specular>0.25 0.25 0.22 1</specular></material></visual></link>
    <link name="alpha/centre_right_wheel_link"><pose>0 -0.60 0.1425 1.5707963 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.041</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="wheel_collision"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><material><ambient>0.20 0.19 0.17 1</ambient><diffuse>0.34 0.32 0.28 1</diffuse><specular>0.25 0.25 0.22 1</specular></material></visual></link>
    <link name="alpha/rear_left_wheel_link"><pose>-0.72 0.60 0.1425 1.5707963 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.041</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="wheel_collision"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><material><ambient>0.20 0.19 0.17 1</ambient><diffuse>0.34 0.32 0.28 1</diffuse><specular>0.25 0.25 0.22 1</specular></material></visual></link>
    <link name="alpha/rear_right_wheel_link"><pose>-0.72 -0.60 0.1425 1.5707963 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.041</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="wheel_collision"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.1425</radius><length>0.12</length></cylinder></geometry><material><ambient>0.20 0.19 0.17 1</ambient><diffuse>0.34 0.32 0.28 1</diffuse><specular>0.25 0.25 0.22 1</specular></material></visual></link>

    <!-- REP-103 rover convention: +X forward, +Y left, +Z up. The drive
         axes are expressed in their steering links so positive wheel rate is
         about +Y at zero steer and produces forward (+X) travel. -->
    <joint name="alpha/front_left_drive_joint" type="revolute"><parent>alpha/front_left_steer_link</parent><child>alpha/front_left_wheel_link</child><axis><xyz expressed_in="alpha/front_left_steer_link">0 1 0</xyz><limit><effort>300</effort><velocity>0.14</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>
    <joint name="alpha/front_right_drive_joint" type="revolute"><parent>alpha/front_right_steer_link</parent><child>alpha/front_right_wheel_link</child><axis><xyz expressed_in="alpha/front_right_steer_link">0 1 0</xyz><limit><effort>300</effort><velocity>0.14</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>
    <joint name="alpha/centre_left_drive_joint" type="revolute"><parent>alpha/centre_left_steer_link</parent><child>alpha/centre_left_wheel_link</child><axis><xyz expressed_in="alpha/centre_left_steer_link">0 1 0</xyz><limit><effort>300</effort><velocity>0.14</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>
    <joint name="alpha/centre_right_drive_joint" type="revolute"><parent>alpha/centre_right_steer_link</parent><child>alpha/centre_right_wheel_link</child><axis><xyz expressed_in="alpha/centre_right_steer_link">0 1 0</xyz><limit><effort>300</effort><velocity>0.14</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>
    <joint name="alpha/rear_left_drive_joint" type="revolute"><parent>alpha/rear_left_steer_link</parent><child>alpha/rear_left_wheel_link</child><axis><xyz expressed_in="alpha/rear_left_steer_link">0 1 0</xyz><limit><effort>300</effort><velocity>0.14</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>
    <joint name="alpha/rear_right_drive_joint" type="revolute"><parent>alpha/rear_right_steer_link</parent><child>alpha/rear_right_wheel_link</child><axis><xyz expressed_in="alpha/rear_right_steer_link">0 1 0</xyz><limit><effort>300</effort><velocity>0.14</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis></joint>

    <!-- Fixed, forward-looking localisation cameras on the front face (~0.6 m AGL). -->
    <link name="alpha/loccam_link">
      <!-- Keep the complete camera bench ahead of the sloped front bevel. -->
      <pose>0.86 0 0.60 0 0.174533 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.006</ixx><iyy>0.001</iyy><izz>0.006</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="mounting_bracket"><pose>-0.075 0 0 0 0 0</pose><geometry><box><size>0.10 0.22 0.075</size></box></geometry><material><ambient>0.42 0.40 0.34 1</ambient><diffuse>0.68 0.65 0.54 1</diffuse><specular>0.25 0.25 0.22 1</specular></material></visual>
      <visual name="housing"><geometry><box><size>0.10 0.33 0.10</size></box></geometry><material><ambient>0.58 0.50 0.30 1</ambient><diffuse>0.82 0.71 0.42 1</diffuse><specular>0.30 0.30 0.25 1</specular></material></visual>
      <visual name="left_bezel"><pose>0.056 0.075 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.040</radius><length>0.018</length></cylinder></geometry><material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      <visual name="right_bezel"><pose>0.056 -0.075 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.040</radius><length>0.018</length></cylinder></geometry><material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      <visual name="left_lens"><pose>0.067 0.075 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.030</radius><length>0.008</length></cylinder></geometry><material><ambient>0.01 0.04 0.07 1</ambient><diffuse>0.02 0.12 0.20 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
      <visual name="right_lens"><pose>0.067 -0.075 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.030</radius><length>0.008</length></cylinder></geometry><material><ambient>0.01 0.04 0.07 1</ambient><diffuse>0.02 0.12 0.20 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
      <sensor name="loccam_left" type="camera"><pose>0.072 0.075 0 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/alpha/loccam/left</topic><camera><horizontal_fov>1.13446</horizontal_fov><image><width>1024</width><height>1024</height><format>R8G8B8</format></image><noise><type>gaussian</type><mean>0</mean><stddev>0.0235294118</stddev><!-- ALPHA_CAMERA_NOISE_STDDEV --></noise><clip><near>0.08</near><far>30</far></clip><lens><intrinsics><fx>800</fx><fy>800</fy><cx>512</cx><cy>512</cy><s>0</s></intrinsics></lens></camera></sensor>
      <sensor name="loccam_right" type="camera"><pose>0.072 -0.075 0 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/alpha/loccam/right</topic><camera><horizontal_fov>1.13446</horizontal_fov><image><width>1024</width><height>1024</height><format>R8G8B8</format></image><noise><type>gaussian</type><mean>0</mean><stddev>0.0235294118</stddev><!-- ALPHA_CAMERA_NOISE_STDDEV --></noise><clip><near>0.08</near><far>30</far></clip><lens><intrinsics><fx>800</fx><fy>800</fy><cx>512</cx><cy>512</cy><s>0</s></intrinsics></lens></camera></sensor>
    </link>
    <joint name="alpha/loccam_joint" type="fixed"><parent>alpha/base_link</parent><child>alpha/loccam_link</child></joint>

    <!-- Deployable mast and pan/tilt head; NavCam optical centres are ~1.9 m AGL. -->
    <link name="alpha/mast_link">
      <pose>0.12 0 1.45 0 0 0</pose>
      <inertial><mass>8</mass><inertia><ixx>0.55</ixx><iyy>0.55</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="mast_collision"><geometry><cylinder><radius>0.055</radius><length>0.84</length></cylinder></geometry></collision>
      <visual name="mast_visual"><geometry><cylinder><radius>0.055</radius><length>0.84</length></cylinder></geometry><material><ambient>0.58 0.58 0.55 1</ambient><diffuse>0.76 0.76 0.72 1</diffuse><specular>0.25 0.25 0.25 1</specular></material></visual>
    </link>
    <joint name="alpha/mast_joint" type="fixed"><parent>alpha/base_link</parent><child>alpha/mast_link</child></joint>
    <link name="alpha/navcam_pan_link"><pose>0.12 0 1.88 0 0 0</pose><inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="pan"><geometry><cylinder><radius>0.09</radius><length>0.08</length></cylinder></geometry><material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.32 0.32 0.32 1</diffuse></material></visual></link>
    <joint name="alpha/navcam_pan_joint" type="revolute"><parent>alpha/mast_link</parent><child>alpha/navcam_pan_link</child><axis><xyz>0 0 1</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper><effort>50</effort><velocity>0.5</velocity></limit><dynamics><damping>5</damping></dynamics></axis></joint>
    <link name="alpha/navcam_link">
      <pose>0.22 0 1.88 0 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.006</ixx><iyy>0.001</iyy><izz>0.006</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="housing"><geometry><box><size>0.079 0.290 0.082</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material></visual>
      <visual name="left_lens"><pose>0.043 0.075 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.025</radius><length>0.012</length></cylinder></geometry><material><ambient>0.01 0.03 0.04 1</ambient><diffuse>0.02 0.07 0.10 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      <visual name="right_lens"><pose>0.043 -0.075 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.025</radius><length>0.012</length></cylinder></geometry><material><ambient>0.01 0.03 0.04 1</ambient><diffuse>0.02 0.07 0.10 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      <sensor name="navcam_left" type="camera"><pose>0.045 0.075 0 0 0 0</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/alpha/navcam/left</topic><camera><horizontal_fov>1.13446</horizontal_fov><image><width>1024</width><height>1024</height><format>R8G8B8</format></image><noise><type>gaussian</type><mean>0</mean><stddev>0.0235294118</stddev><!-- ALPHA_CAMERA_NOISE_STDDEV --></noise><clip><near>0.1</near><far>60</far></clip><lens><intrinsics><fx>800</fx><fy>800</fy><cx>512</cx><cy>512</cy><s>0</s></intrinsics></lens></camera></sensor>
      <sensor name="navcam_right" type="camera"><pose>0.045 -0.075 0 0 0 0</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/alpha/navcam/right</topic><camera><horizontal_fov>1.13446</horizontal_fov><image><width>1024</width><height>1024</height><format>R8G8B8</format></image><noise><type>gaussian</type><mean>0</mean><stddev>0.0235294118</stddev><!-- ALPHA_CAMERA_NOISE_STDDEV --></noise><clip><near>0.1</near><far>60</far></clip><lens><intrinsics><fx>800</fx><fy>800</fy><cx>512</cx><cy>512</cy><s>0</s></intrinsics></lens></camera></sensor>
    </link>
    <joint name="alpha/navcam_tilt_joint" type="revolute"><pose relative_to="alpha/navcam_link">-0.10 0 0 0 0 0</pose><parent>alpha/navcam_pan_link</parent><child>alpha/navcam_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper><effort>50</effort><velocity>0.5</velocity></limit><dynamics><damping>5</damping></dynamics></axis></joint>

    <!--
      One actuator message commands all twelve wheel DOFs. Array order for
      both position[] (steering, rad) and velocity[] (drive, rad/s):
      FL, FR, CL, CR, RL, RR.
    -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>alpha/front_left_drive_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>0</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>alpha/front_right_drive_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>1</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>alpha/centre_left_drive_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>2</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>alpha/centre_right_drive_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>3</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>alpha/rear_left_drive_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>4</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>alpha/rear_right_drive_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>5</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>alpha/front_left_steer_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>0</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic><p_gain>300</p_gain><i_gain>0</i_gain><d_gain>30</d_gain><cmd_max>500</cmd_max><cmd_min>-500</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>alpha/front_right_steer_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>1</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic><p_gain>300</p_gain><i_gain>0</i_gain><d_gain>30</d_gain><cmd_max>500</cmd_max><cmd_min>-500</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>alpha/centre_left_steer_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>2</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic><p_gain>300</p_gain><i_gain>0</i_gain><d_gain>30</d_gain><cmd_max>500</cmd_max><cmd_min>-500</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>alpha/centre_right_steer_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>3</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic><p_gain>300</p_gain><i_gain>0</i_gain><d_gain>30</d_gain><cmd_max>500</cmd_max><cmd_min>-500</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>alpha/rear_left_steer_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>4</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic><p_gain>300</p_gain><i_gain>0</i_gain><d_gain>30</d_gain><cmd_max>500</cmd_max><cmd_min>-500</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>alpha/rear_right_steer_joint</joint_name><use_actuator_msg>true</use_actuator_msg><actuator_number>5</actuator_number><topic>/alpha/cmd/wheel_joint_states</topic><p_gain>300</p_gain><i_gain>0</i_gain><d_gain>30</d_gain><cmd_max>500</cmd_max><cmd_min>-500</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/alpha/raw/joint_states</topic>
      <joint_name>alpha/front_left_bogie_joint</joint_name><joint_name>alpha/front_right_bogie_joint</joint_name><joint_name>alpha/rear_bogie_joint</joint_name>
      <joint_name>alpha/front_left_steer_joint</joint_name><joint_name>alpha/front_right_steer_joint</joint_name><joint_name>alpha/centre_left_steer_joint</joint_name><joint_name>alpha/centre_right_steer_joint</joint_name><joint_name>alpha/rear_left_steer_joint</joint_name><joint_name>alpha/rear_right_steer_joint</joint_name>
      <joint_name>alpha/front_left_drive_joint</joint_name><joint_name>alpha/front_right_drive_joint</joint_name><joint_name>alpha/centre_left_drive_joint</joint_name><joint_name>alpha/centre_right_drive_joint</joint_name><joint_name>alpha/rear_left_drive_joint</joint_name><joint_name>alpha/rear_right_drive_joint</joint_name>
      <joint_name>alpha/navcam_pan_joint</joint_name><joint_name>alpha/navcam_tilt_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>map</odom_frame>
      <robot_base_frame>alpha/base_link</robot_base_frame>
      <!-- OdometryPublisher measures the model entity origin. Apply the fixed
           model-to-base offset so the pose matches the advertised child. -->
      <xyz_offset>0 0 0.72</xyz_offset>
      <odom_topic>/alpha/odometry</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
