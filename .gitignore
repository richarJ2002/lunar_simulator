# Git ignore file which ignores changes to files that follow the convention below

# Ignore .VSCodeCounter Extension Outputs
**.VSCodeCounter

# Ignore .vscode setting files
**.vscode

# Ignore the virtual python environment
.venv/

# ROS build ignore
build/*
install/*
log/*
test_runs/

# Blender ignores
*.blend

# ROS general ignores
rosbag**/*
*.log

# Python bytecode (launch/__pycache__/ was previously tracked)
__pycache__/
*.pyc

# Opencode artifacts
AGENTS.md
.agents/*
